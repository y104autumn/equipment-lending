# .gitignore — equipment-lending
#
# 除外する行には WHY を書く（「派生物で再生成できる」「秘密情報」など）。

# ---- §0 全リポ共通 --------------------------------------------------------

# 秘密情報（API キー・トークン・cookie）— 絶対にコミットしない
.env
.env.*
*.key
*-cookies.txt

# Claude Code の個人設定（自動追記される・git 管理外。committed の許可は .claude/settings.json に書く）
.claude/settings.local.json

# 一時・ログ（実行環境ごとに違う）
tmp/
logs/
*.log
.playwright-mcp/

# OS・エディタの生成物
.DS_Store
Thumbs.db

# ---- §1 Python -----------------------------------------------------------
# 記入ガイド: Python を使わないなら節ごと消す

venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- §2 Node --------------------------------------------------------------

node_modules/
dist/
.astro/

# ---- §3 Java / Maven ------------------------------------------------------
# 記入ガイド: `.mvn/wrapper/maven-wrapper.jar` は追跡してよい（ラッパーの正本）

target/
*.class
.classpath
.project
.settings/

# ---- §4 Flutter / Dart ----------------------------------------------------

.dart_tool/
build/
*.g.dart

# ---- §5 データ・派生物（プロファイル B・C 向け） ----------------------------
# 記入ガイド: 1 行ごとに「何から再生成できるか」を書く。目録は追跡する。

# 派生物: ベクトル DB は md から再構築できる（正本ではない）
# chroma_db/

# 原本のバイナリ本体は容量が大きいので追跡しない。
# ⛔ ただし manifest.jsonl（sha256 付きの目録）は正本なので必ず追跡する。
# data/**/raw/

# 一次資料の PDF 本体。再配布ライセンスが確認できていないものを含むため追跡しない。
# ⛔ ただし research/_LEDGER.md の目録（URL・sha256・ライセンス）は正本なので必ず追跡する。
# research/_pdf/
